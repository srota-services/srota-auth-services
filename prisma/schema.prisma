// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
   provider = "prisma-client-js"
}

datasource db {
   provider = "postgresql"
   url      = env("DATABASE_URL")
}

enum Role {
   LISTENER
   GLOBAL_ADMIN
   ORG_ADMIN
   ORG_COORDINATOR
   AUTHOR
   GUEST
}

enum OtpPurpose {
   LOGIN
   REGISTRATION
   EMAIL_UPDATE
   PASSWORD_UPDATE
   PASSWORD_RESET
   DEVICE_REMOVAL
}

enum EmailType {
   OTP
   VERIFICATION
   PASSWORD_RESET
   WELCOME
   NOTIFICATION
}

enum Gender {
   MALE
   FEMALE
   NON_BINARY
   OTHER
   PREFER_NOT_TO_SAY
}

model User {
   id            String   @id @default(uuid())
   email         String   @unique
   password      String? // Hashed password (nullable for OAuth users)
   googleId      String?  @unique // Google OAuth ID
   role          Role     @default(LISTENER)
   emailVerified Boolean  @default(false)
   firstName     String?
   lastName      String?
   address       String?
   contact       String?
   gender        Gender?
   location      String?
   age           Int?
   createdAt     DateTime @default(now())
   updatedAt     DateTime @updatedAt

   // Relations
   refreshTokens           RefreshToken[]
   emailVerificationTokens EmailVerificationToken[]
   passwordResetTokens     PasswordResetToken[]
   otpTokens               OtpToken[]
   emailLogs               EmailLog[]
   subscriptions           UserSubscription[]
   devices                   UserDevice[]
   deviceChanges             UserDeviceChange[]
   author                    Author?
   organizationMembers       OrganizationMember[]

   @@map("users")
}

enum UserDeviceChangeType {
   ADDED
   REMOVED
}

model UserDevice {
   id         String   @id @default(uuid())
   userId     String
   deviceId   String
   deviceName String?
   platform   String?
   userAgent  String?
   ipAddress  String?
   lastSeenAt DateTime @default(now())
   createdAt  DateTime @default(now())

   user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
   refreshTokens RefreshToken[]
   deviceChanges UserDeviceChange[]

   @@unique([userId, deviceId])
   @@index([userId])
   @@map("user_devices")
}

model UserDeviceChange {
   id           String               @id @default(uuid())
   userId       String
   type         UserDeviceChangeType
   userDeviceId String?
   createdAt    DateTime             @default(now())

   user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
   userDevice UserDevice? @relation(fields: [userDeviceId], references: [id], onDelete: SetNull)

   @@index([userId, createdAt])
   @@map("user_device_changes")
}

enum BillingInterval {
   MONTHLY
   QUARTERLY
   YEARLY
   LIFETIME
}

enum SubscriptionStatus {
   PENDING
   TRIALING
   ACTIVE
   PAST_DUE
   PAUSED
   CANCELED
   EXPIRED
}

enum PlanChangeType {
   UPGRADE
   DOWNGRADE
}

enum BillingEventType {
   PRORATION_CHARGE
   RENEWAL_CHARGE
   RENEWAL_FAILED
   RENEWAL_RETRY_FAILED
   PLAN_CHANGE_SCHEDULED
}

enum SubscriptionTierLevel {
   BASE
   STANDARD
   PREMIUM
}

model SubscriptionPlan {
   id          String  @id @default(cuid())
   name        String  @unique
   description String?

   price    Decimal @db.Decimal(10, 2)
   currency String  @default("USD")

   tierLevel SubscriptionTierLevel

   billingInterval BillingInterval @default(MONTHLY)
   trialDays       Int             @default(0)

   features Json?

   isActive Boolean @default(true)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   subscriptions        UserSubscription[] @relation("CurrentPlan")
   pendingSubscriptions UserSubscription[] @relation("PendingPlan")

   @@map("subscription_plans")
}

model UserSubscription {
   id     String @id @default(cuid())
   userId String
   planId String

   status             SubscriptionStatus @default(PENDING)
   startDate          DateTime           @default(now())
   endDate            DateTime?
   currentPeriodStart DateTime           @default(now())
   currentPeriodEnd   DateTime
   trialEndsAt        DateTime?

   cancelAtPeriodEnd Boolean   @default(false)
   canceledAt        DateTime?

   autoRenew     Boolean @default(true)
   paymentMethod String?

   pendingPlanId         String?
   pendingPlanChangeAt   DateTime?
   pendingPlanChangeType PlanChangeType?

   pastDueRetryCount Int @default(0)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
   plan          SubscriptionPlan           @relation("CurrentPlan", fields: [planId], references: [id])
   pendingPlan   SubscriptionPlan?          @relation("PendingPlan", fields: [pendingPlanId], references: [id])
   billingEvents SubscriptionBillingEvent[]

   @@index([userId])
   @@index([planId])
   @@index([status])
   @@index([pendingPlanId])
   @@map("user_subscriptions")
}

model SubscriptionBillingEvent {
   id                 String           @id @default(cuid())
   userSubscriptionId String
   type               BillingEventType
   amount             Decimal          @db.Decimal(10, 2)
   currency           String
   metadata           Json?
   createdAt          DateTime         @default(now())

   userSubscription UserSubscription @relation(fields: [userSubscriptionId], references: [id], onDelete: Cascade)

   @@index([userSubscriptionId])
   @@index([type])
   @@map("subscription_billing_events")
}

model RefreshToken {
   id           String   @id @default(uuid())
   token        String   @unique
   userId       String
   userDeviceId String?
   expiresAt    DateTime
   createdAt    DateTime @default(now())
   isRevoked    Boolean  @default(false)
   replacedBy   String? // ID of the token that replaced this one
   userAgent    String?
   ipAddress    String?

   // Relations
   user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
   userDevice UserDevice? @relation(fields: [userDeviceId], references: [id], onDelete: SetNull)

   @@index([userDeviceId])
   @@map("refresh_tokens")
}

model EmailVerificationToken {
   id        String   @id @default(uuid())
   token     String   @unique
   userId    String
   expiresAt DateTime
   createdAt DateTime @default(now())
   used      Boolean  @default(false)

   // Relations
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@map("email_verification_tokens")
}

model PasswordResetToken {
   id        String   @id @default(uuid())
   token     String   @unique
   userId    String
   expiresAt DateTime
   createdAt DateTime @default(now())
   used      Boolean  @default(false)

   // Relations
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@map("password_reset_tokens")
}

model OtpToken {
   id            String     @id @default(uuid())
   codeHash      String     @unique // Hashed OTP code using Argon2
   userId        String
   purpose       OtpPurpose
   expiresAt     DateTime
   attempts      Int        @default(0)
   isVerified    Boolean    @default(false)
   createdAt     DateTime   @default(now())
   invalidatedAt DateTime?

   // Relations
   user User @relation(fields: [userId], references: [id], onDelete: Cascade)

   @@map("otp_tokens")
}

model EmailLog {
   id               String    @id @default(uuid())
   subject          String
   body             String    @db.Text
   recipientAddress String
   senderAddress    String
   emailType        EmailType
   sentAt           DateTime  @default(now())
   userId           String?
   createdAt        DateTime  @default(now())

   // Relations
   user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

   @@map("email_logs")
}

enum OrganizationRole {
   OWNER
   ADMIN
}

enum OrganizationTeamSize {
   SIZE_1_10     @map("1-10")
   SIZE_11_50    @map("11-50")
   SIZE_51_200   @map("51-200")
   SIZE_200_PLUS @map("200+")
}

enum AuthorOrganizationInvitationStatus {
   PENDING_CONTACT_CONSENT
   AWAITING_ORG_CONTACT
   AWAITING_JOIN_DECISION
   DECLINED
   ACCEPTED
}

model Organization {
   id             String                @id @default(cuid())
   name           String
   slug           String                @unique
   description    String?
   image          String?
   preferredGenre String?
   websiteUrl     String?
   teamSize       OrganizationTeamSize?
   discoverable   Boolean               @default(false)

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   members OrganizationMember[]
   authors AuthorOrganization[]
   authorInvitations AuthorOrganizationInvitation[]

   @@map("organizations")
}

model Author {
   id     String @id @default(cuid())
   userId String @unique
   slug   String @unique

   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
   organizations AuthorOrganization[]
   organizationInvitations AuthorOrganizationInvitation[]

   @@map("authors")
}

model AuthorOrganization {
   id             String @id @default(cuid())
   authorId       String
   organizationId String

   createdAt DateTime @default(now())

   author       Author       @relation(fields: [authorId], references: [id], onDelete: Cascade)
   organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

   @@unique([authorId, organizationId])
   @@map("author_organizations")
}

model AuthorOrganizationInvitation {
   id                    String                             @id @default(cuid())
   organizationId        String
   authorId              String
   status                AuthorOrganizationInvitationStatus
   contactRevealedAt     DateTime?
   orgContactConfirmedAt DateTime?
   respondedAt           DateTime?
   createdAt             DateTime                           @default(now())
   updatedAt             DateTime                           @updatedAt

   organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
   author       Author       @relation(fields: [authorId], references: [id], onDelete: Cascade)

   @@unique([organizationId, authorId])
   @@index([authorId, status])
   @@index([organizationId, status])
   @@map("author_organization_invitations")
}

model OrganizationMember {
   id             String           @id @default(cuid())
   userId         String
   organizationId String
   role           OrganizationRole @default(ADMIN)

   joinedAt  DateTime @default(now())
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt

   user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
   organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

   @@unique([userId, organizationId])
   @@index([organizationId])
   @@map("organization_members")
}

enum ImageCategory {
   organization
}

model ImagePlaceholderSpec {
   id                   String        @id @default(cuid())
   category             ImageCategory
   variantKey           String
   actualWidth          Int
   actualHeight         Int
   aspectRatioWidth     Int
   aspectRatioHeight    Int
   recommendedMaxWidth  Int
   recommendedMaxHeight Int

   @@unique([category, variantKey])
   @@map("image_placeholder_specs")
}

model ImageAsset {
   id          String        @id @default(cuid())
   category    ImageCategory
   entityId    String
   variantKey  String
   storageKey  String
   width       Int
   height      Int
   createdAt   DateTime      @default(now())
   updatedAt   DateTime      @updatedAt

   @@unique([category, entityId, variantKey])
   @@index([category, entityId])
   @@map("image_assets")
}
