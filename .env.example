# Environment Variables Template
# Copy this file to .env.development and update the values for your environment

# Environment
NODE_ENV=development

# Server Configuration
PORT=8080

# Reverse proxy (Express trust proxy hop count)
# Number of trusted reverse-proxy hops in front of this service (e.g. nginx).
# Use 0 when hitting Node directly (local dev). Use 1 for a single nginx/LB hop.
# Required for express-rate-limit to honor X-Forwarded-For and for secure cookies behind HTTPS.
TRUST_PROXY=0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auth_service

HEALTH_SUPPORT_EMAIL=no-reply@srota-support.com
HEALTH_SUPPORT_PASSWORD=

# Subscription plan seed currency
SUBSCRIPTION_CURRENCY=INR

# Subscription background jobs (optional)
# SUBSCRIPTION_JOBS_ENABLED=true
# SUBSCRIPTION_RENEWAL_CRON=0 0 * * *
# SUBSCRIPTION_DOWNGRADE_CRON=1 0 * * *
# SUBSCRIPTION_EXPIRATION_CRON=2 0 * * *

# Redis
REDIS_URL=redis://localhost:6379

# Location reverse geocoding (Nominatim)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=SrotaAuth/1.0 (profile-location-resolver)

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=users
RABBITMQ_AUTHORS_EXCHANGE=authors
RABBITMQ_ORGANIZATIONS_EXCHANGE=organizations

# JWT Configuration
# Generate keys: npm run generate-keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=auth-service-dev-key
JWT_ISSUER=auth-service-dev
JWT_ACCESS_TOKEN_EXPIRY=7d
JWT_REFRESH_TOKEN_EXPIRY=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Email Configuration
EMAIL_FROM=dev@audiobook.com
EMAIL_SERVICE_URL=

# Google OAuth Configuration
GOOGLE_CLIENT_ID=

# Security Configuration
ARGON2_MEMORY=32768
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=2

# File uploads (same S3 bucket as app-service)
MAX_FILE_SIZE=52428800
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_SIGNED_URL_EXPIRES_IN=3600

# Logging
LOG_LEVEL=debug
